<Window x:Class="PoeAncientsPriceHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="PoE 2 Ground Loot Price Helper 1.0.0" Height="410" Width="540"
        Icon="app.ico"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#999"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>

        <!-- Flat button that respects local Background/Foreground/BorderBrush.
             WPF UI's implicit Button style ignores local colors via its ControlTemplate;
             this custom template uses TemplateBinding so colors always apply, including
             when disabled (opacity dim instead of gray overlay). -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.82"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.68"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                Background="#15251D" BorderBrush="#2F7D4C" BorderThickness="1"
                CornerRadius="7" Padding="12,9" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="PoE2 Ground Loot Price Overlay"
                           Foreground="#7CFF9B" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Improved full-screen ground-loot pricing for Path of Exile 2"
                           Foreground="#9AB8A2" FontSize="11" Margin="0,3,0,0"/>
                <TextBlock Text="Local development build · external auto-update disabled"
                           Foreground="#6F8C77" FontSize="10" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="League:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LeagueBox" Margin="0,4" SelectionChanged="LeagueBox_SelectionChanged"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Scan area:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RegionLabel" Text="PoE 2 viewport (automatic)" Foreground="#666" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>

        <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                x:Name="CalibrateButton" Style="{StaticResource FlatButton}"
                Content="Set fallback screen region" Margin="0,10,0,0"
                Background="#1A2A3A" Foreground="#66AAFF" BorderBrush="#336699"
                Click="CalibrateButton_Click"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                   x:Name="StatusLabel"
                   Text="Idle — prices not loaded"
                   Foreground="#666" FontSize="11" Margin="0,10,0,0"/>

        <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                x:Name="StartStopButton" Style="{StaticResource FlatButton}"
                Content="Start Ground Loot Scan" IsEnabled="False"
                Margin="0,10,0,0"
                Background="#1A3A1A" Foreground="#66FF66" BorderBrush="#337733"
                Click="StartStopButton_Click"/>

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Orientation="Horizontal">
            <TextBlock x:Name="VersionLabel"
                       Foreground="#666" FontSize="11" VerticalAlignment="Bottom"/>
            <TextBlock Text="·" Foreground="#666" FontSize="11"
                       VerticalAlignment="Bottom" Margin="6,0,0,0"/>
            <TextBlock x:Name="CreditsLink" Text="Credits"
                       Foreground="#999" FontSize="11" VerticalAlignment="Bottom"
                       Cursor="Hand" TextDecorations="Underline" Margin="6,0,0,0"
                       ToolTip="Thanks to the people who contributed"
                       MouseLeftButtonUp="CreditsLink_Click"/>
            <TextBlock Text="·" Foreground="#666" FontSize="11"
                       VerticalAlignment="Bottom" Margin="6,0,0,0"/>
            <TextBlock x:Name="DiagnosticsLink" Text="Diagnostics"
                       Foreground="#999" FontSize="11" VerticalAlignment="Bottom"
                       Cursor="Hand" TextDecorations="Underline" Margin="6,0,0,0"
                       ToolTip="Restart with logging enabled to capture a report for a bug"
                       MouseLeftButtonUp="DiagnosticsLink_Click"/>
        </StackPanel>

        <!-- Settings (gear opens the Settings window: keybinds, theme, capture mode, auto-start)
             sits just left of the donate button so both share the bottom-right corner at the same height. -->
        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Orientation="Horizontal">
            <Button x:Name="HelpButton" Style="{StaticResource FlatButton}"
                    Content="❔ Help" FontSize="11"
                    Padding="10,4" Margin="0,0,8,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#444"
                    ToolTip="Open the guide — how to use the app, calibration, rumours, reporting bugs"
                    Click="HelpButton_Click"/>
            <Button x:Name="SettingsButton" Style="{StaticResource FlatButton}"
                    Content="⚙ Settings" FontSize="11"
                    Padding="10,4" Margin="0,0,8,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#444"
                    ToolTip="Settings — hotkeys, theme, capture mode, auto-start"
                    Click="SettingsButton_Click"/>
            <Button x:Name="DonateButton" Style="{StaticResource FlatButton}"
                    Content="☕ Buy me a coffee"
                    Padding="10,4" FontSize="11"
                    Background="#3A2A12" Foreground="#E0B060" BorderBrush="#7A5A20"
                    ToolTip="Support development via PayPal — thank you!"
                    Click="DonateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
