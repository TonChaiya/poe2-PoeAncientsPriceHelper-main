<Window x:Class="PoeTradeOverlay.Presentation.TradeOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoE 2 Trade Evaluation" Width="420" Height="690" MinWidth="390" MinHeight="560"
        MaxWidth="470" ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        ResizeMode="CanResizeWithGrip" WindowStyle="None" KeyDown="Window_KeyDown"
        Background="#0B0D0C" Foreground="#E8E0C9" Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#242720"/><Setter Property="Foreground" Value="#E8E0C9"/>
            <Setter Property="BorderBrush" Value="#514A38"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1B1F1B"/><Setter Property="Foreground" Value="#F4EFD9"/>
            <Setter Property="BorderBrush" Value="#45493F"/><Setter Property="Padding" Value="5,3"/>
            <Setter Property="CaretBrush" Value="#D1B45A"/><Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Profile" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B8B29E"/><Setter Property="Background" Value="#181B17"/>
            <Setter Property="BorderBrush" Value="#454234"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Frame" Property="Background" Value="#554617"/>
                    <Setter TargetName="Frame" Property="BorderBrush" Value="#B29235"/>
                    <Setter Property="Foreground" Value="#FFF0B4"/>
                </Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#8B702B" BorderThickness="1" Background="#0E120F">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#171A16" BorderBrush="#4E442B" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Title_MouseLeftButtonDown" MouseMove="Title_MouseMove"
                    MouseLeftButtonUp="Title_MouseLeftButtonUp">
                <Grid Margin="10,0,4,0">
                    <TextBlock Text="POE 2 · TRADE EVALUATION" Foreground="#C2AD6A" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="EditButton" Content="Edit" Margin="0,4" Padding="9,1" FontSize="10" Click="Edit_Click"/>
                        <Button Content="×" Width="27" Margin="5,4,0,4" Padding="0" FontSize="14" Background="#3C1D1B" BorderBrush="#704039" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="14,10,14,7">
                <TextBlock Text="{Binding BaseTypeText}" HorizontalAlignment="Center" FontFamily="Georgia" FontSize="19" FontWeight="SemiBold" Foreground="{Binding RarityBrush}"/>
                <TextBlock Text="{Binding DisplayName}" HorizontalAlignment="Center" Foreground="#BDB49B" FontSize="11"/>
                <WrapPanel HorizontalAlignment="Center" Margin="0,5,0,0">
                    <TextBlock Text="{Binding RarityText}" Foreground="{Binding RarityBrush}" FontWeight="Bold" FontSize="10" Margin="5,0"/>
                    <TextBlock Text="{Binding ItemLevelText}" Foreground="#8F958A" FontSize="10" Margin="5,0"/>
                    <TextBlock Text="{Binding QualityText}" Foreground="#8F958A" FontSize="10" Margin="5,0"/>
                    <TextBlock Text="{Binding CorruptedText}" Foreground="#E15B55" FontSize="10" Margin="5,0"/>
                </WrapPanel>
            </StackPanel>

            <Grid Grid.Row="2" Margin="14,0,14,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0" Style="{StaticResource Profile}" Content="Crafting Base" Tag="CraftingBase" IsChecked="{Binding IsCraftingBase, Mode=OneWay}" Click="Profile_Click"/>
                <RadioButton Grid.Column="1" Style="{StaticResource Profile}" Content="Quick Price" Tag="QuickPrice" IsChecked="{Binding IsQuickPrice, Mode=OneWay}" Click="Profile_Click"/>
                <RadioButton Grid.Column="2" Style="{StaticResource Profile}" Content="Broad −10%" Tag="Broad" IsChecked="{Binding IsBroad, Mode=OneWay}" Click="Profile_Click"/>
            </Grid>

            <Border Grid.Row="3" Margin="14,0" Background="#111511" BorderBrush="#30352E" BorderThickness="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="23" Background="#1D211C">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="MODIFIER" Foreground="#8B927F" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="MIN" Foreground="#8B927F" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="MAX" Foreground="#8B927F" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Filters}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="#293029" BorderThickness="0,0,0,1" Padding="5,6">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanEnable}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="0,0,5,0">
                                        <TextBlock Text="{Binding Text}" Foreground="#E8E3D5" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding FamilyCaption}" Foreground="#748C7A" FontSize="8" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#E06C67" FontSize="8"/>
                                    </StackPanel>
                                    <Grid Grid.Column="2" Margin="2,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="18"/></Grid.RowDefinitions>
                                        <TextBox Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="−" Command="{Binding DecreaseMin}" Width="20" Padding="0"/><Button Content="+" Command="{Binding IncreaseMin}" Width="20" Padding="0"/><Button Content="×" Command="{Binding ClearMin}" Width="20" Padding="0"/></StackPanel>
                                    </Grid>
                                    <Grid Grid.Column="3" Margin="2,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="18"/></Grid.RowDefinitions>
                                        <TextBox Text="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="−" Command="{Binding DecreaseMax}" Width="20" Padding="0"/><Button Content="+" Command="{Binding IncreaseMax}" Width="20" Padding="0"/><Button Content="×" Command="{Binding ClearMax}" Width="20" Padding="0"/></StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Row="4" Margin="14,8,14,0" Padding="10,8" Background="#181812" BorderBrush="#554727" BorderThickness="1">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="ESTIMATED VALUE" Foreground="#9E8A53" FontSize="8"/><TextBlock Text="{Binding MedianText}" Foreground="#F0DFA6" FontWeight="Bold" FontSize="20"/><TextBlock Text="{Binding RangeText, StringFormat=Range  {0}}" Foreground="#AAA28D" FontSize="9"/></StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding MatchText}" HorizontalAlignment="Right" FontSize="11"/><TextBlock Text="{Binding SampleText}" HorizontalAlignment="Right" Foreground="#9A9B8D" FontSize="9"/><TextBlock Text="{Binding ConfidenceText}" HorizontalAlignment="Right" Foreground="#CEA94D" FontSize="9" TextWrapping="Wrap"/></StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="5" Margin="14,7,14,0" MaxHeight="125" Background="#101310" BorderBrush="#30332D" BorderThickness="1" Visibility="{Binding HasListings, Converter={StaticResource Visible}}">
                <DockPanel><Grid DockPanel.Dock="Top" Height="22" Background="#22241F"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="PRICE" Margin="8,0" VerticalAlignment="Center" Foreground="#BDAA68" FontSize="9"/><TextBlock Grid.Column="1" Text="ACCOUNT" Margin="6,0" VerticalAlignment="Center" Foreground="#BDAA68" FontSize="9"/></Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Listings}"><ItemsControl.ItemTemplate><DataTemplate><Grid MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="8,3"><TextBlock Text="{Binding PriceText}" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="{Binding EquivalentText}" Foreground="#77B985" FontSize="8"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Account}" Margin="6,0" VerticalAlignment="Center" Foreground="#A6A28E" FontSize="9" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Row="6" Margin="14,8,14,11"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="#A8B3A8" FontSize="9" TextWrapping="Wrap" MaxWidth="245"/><TextBlock Text="Passive mouse mode · Edit enables typing" Foreground="#676C62" FontSize="8"/></StackPanel>
                <Button Grid.Column="1" Content="Search" IsEnabled="{Binding CanSearch}" MinWidth="102" Padding="12,7" Background="#6B551D" BorderBrush="#B49338" Foreground="#FFF1BF" FontWeight="SemiBold" Click="Search_Click"/>
                <ProgressBar Grid.ColumnSpan="2" IsIndeterminate="True" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-6" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" Foreground="#B49338" Background="#20241F"/>
            </Grid>
        </Grid>
    </Border>
</Window>
