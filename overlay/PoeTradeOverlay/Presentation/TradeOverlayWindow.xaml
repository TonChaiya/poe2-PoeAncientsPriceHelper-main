<Window x:Class="PoeTradeOverlay.Presentation.TradeOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoE 2 Detailed Trade Check" Width="500" Height="780"
        MinWidth="430" MinHeight="620" ShowActivated="False" ShowInTaskbar="False"
        Topmost="True" ResizeMode="CanResizeWithGrip" WindowStyle="None"
        Background="#0B0D0C" Foreground="#E8E0C9" Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#20231F"/>
            <Setter Property="Foreground" Value="#F2EBD8"/>
            <Setter Property="BorderBrush" Value="#45483F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="CaretBrush" Value="#D7BD6A"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#292C26"/>
            <Setter Property="Foreground" Value="#E8E0C9"/>
            <Setter Property="BorderBrush" Value="#5A5545"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="FilterCheck" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#8B6E28" BorderThickness="1" Background="#0E120F">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#171A16" BorderBrush="#4D4228" BorderThickness="0,0,0,1">
                <Grid Margin="12,0,6,0">
                    <TextBlock Text="POE 2 · TRADE EVALUATION" Foreground="#B5A477" FontSize="11"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               MouseLeftButtonDown="Title_MouseLeftButtonDown"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="EditButton" Content="Edit filters" Margin="0,4,5,4" Padding="10,2"
                                FontSize="10" Click="Edit_Click"/>
                        <Button Content="×" Width="28" Margin="0,4,0,4" Padding="0" FontSize="15"
                                Background="#40201D" BorderBrush="#73413B" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,14,18,10">
                <TextBlock Text="{Binding BaseTypeText}" HorizontalAlignment="Center" FontFamily="Georgia"
                           FontSize="21" FontWeight="SemiBold" Foreground="{Binding RarityBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding DisplayName}" HorizontalAlignment="Center" Margin="0,3,0,0"
                           FontSize="13" Foreground="#C8BEA4" TextWrapping="Wrap"/>
                <Border Height="1" Background="#6C5521" Margin="0,11,0,9"/>
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding RarityText}" Foreground="{Binding RarityBrush}" FontWeight="Bold" Margin="8,0"/>
                    <TextBlock Text="{Binding ItemLevelText}" Foreground="#A9A695" Margin="8,0"/>
                    <TextBlock Text="{Binding QualityText}" Foreground="#A9A695" Margin="8,0"/>
                    <TextBlock Text="{Binding CorruptedText}" Foreground="#E64848" FontWeight="Bold" Margin="8,0"/>
                </WrapPanel>
            </StackPanel>

            <Border Grid.Row="2" Margin="18,0,18,8" Padding="10,7" Background="#151916" CornerRadius="3">
                <Grid>
                    <TextBlock Text="{Binding Status}" Foreground="#B8C2B8" TextWrapping="Wrap"/>
                    <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Bottom" Margin="0,23,0,0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}"
                                 Foreground="#B0903D" Background="#252B25"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="3" Margin="18,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/><ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="MODIFIER" Foreground="#7F8B7E" FontSize="9"/>
                        <TextBlock Grid.Column="2" Text="MIN" Foreground="#7F8B7E" FontSize="9" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="MAX" Foreground="#7F8B7E" FontSize="9" HorizontalAlignment="Center"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding SupportedFilters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#2C332D" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/><ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource FilterCheck}" IsChecked="{Binding IsEnabled}"/>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#E9E4D7" FontSize="12"/>
                                            <TextBlock Text="{Binding ValidationMessage}" Foreground="#FF7777" FontSize="9"/>
                                        </StackPanel>
                                        <TextBox Grid.Column="2" Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}" Margin="3,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}" Margin="3,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Expander Margin="0,8,0,0" Foreground="#858B83"
                              Visibility="{Binding HasUnsupported, Converter={StaticResource BoolVisibility}}">
                        <Expander.Header>
                            <TextBlock Text="{Binding UnsupportedCountText}" Foreground="#858B83" FontSize="10"/>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding UnsupportedFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="#777D76" FontSize="10"
                                               TextWrapping="Wrap" Margin="22,4,4,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="4" Margin="18,10,18,0" Padding="12,10" Background="#171713"
                    BorderBrush="#514526" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ESTIMATED VALUE" Foreground="#9C8C61" FontSize="9"/>
                        <TextBlock Text="{Binding MedianText}" FontSize="22" FontWeight="Bold" Foreground="#F0E2B5"/>
                        <TextBlock Text="{Binding RangeText, StringFormat=Typical range  {0}}" Foreground="#B3AD9B" FontSize="10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MatchText}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SampleText}" HorizontalAlignment="Right" FontSize="10" Foreground="#A9A695"/>
                        <TextBlock Text="{Binding ConfidenceText}" HorizontalAlignment="Right" FontSize="10" Foreground="#D3A84F"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="5" Margin="18,8,18,0" MaxHeight="145" Background="#111411"
                    BorderBrush="#34362F" BorderThickness="1"
                    Visibility="{Binding HasListings, Converter={StaticResource BoolVisibility}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="#24251F" Height="27">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="PRICE" Margin="10,0" VerticalAlignment="Center" Foreground="#C7B474" FontSize="10"/>
                        <TextBlock Grid.Column="1" Text="ACCOUNT" Margin="8,0" VerticalAlignment="Center" Foreground="#C7B474" FontSize="10"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Listings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="27">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding PriceText}" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Account}" Margin="8,0" VerticalAlignment="Center"
                                                   Foreground="#AAA690" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Row="6" Margin="18,10,18,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Passive mode keeps the game focused" Foreground="#7E877D" FontSize="9"/>
                    <TextBlock Text="Use Borderless mode before typing filters" Foreground="#665F4D" FontSize="9"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Search price" IsEnabled="{Binding CanSearch}"
                        MinWidth="125" Background="#70591F" BorderBrush="#B0923E" Foreground="#FFF3CA"
                        FontWeight="SemiBold" Click="Search_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
